KIOSY_ENV=development
KIOSY_DATABASE_URL=postgresql+psycopg://kiosy:kiosy@localhost:5432/kiosy
KIOSY_FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KIOSY_PUBLIC_API_URL=http://localhost:8000
KIOSY_COOKIE_SECURE=false
KIOSY_COOKIE_SAMESITE=lax
KIOSY_COOKIE_DOMAIN=
KIOSY_SECRET_KEY=replace-with-at-least-32-random-characters
KIOSY_TEST_PAYMENT_ENABLED=true
KIOSY_STORAGE_ENDPOINT=http://localhost:9090
KIOSY_STORAGE_BUCKET=kiosy-private
KIOSY_STORAGE_ACCESS_KEY=local-s3-key
KIOSY_STORAGE_SECRET_KEY=replace-me
KIOSY_STORAGE_PUBLIC_ORIGIN=http://localhost:9090
KIOSY_STORAGE_PRESIGNED_TTL_SECONDS=300
KIOSY_QDRANT_URL=http://localhost:6333
KIOSY_EMAIL_MODE=mailpit
KIOSY_SMTP_HOST=localhost
KIOSY_SMTP_PORT=1025
KIOSY_SMTP_USERNAME=
KIOSY_SMTP_PASSWORD=
KIOSY_SMTP_FROM=Kiosy <no-reply@kiosy.example>
KIOSY_SMTP_STARTTLS=false
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_ENDPOINT=https://h4h-openai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=gpt-35-turbo
KIOSY_EMBEDDING_NAMESPACE_VERSION=v1
KIOSY_ENABLE_LIVE_AZURE=false
KIOSY_RUN_MAX_DELEGATIONS=4
KIOSY_RUN_MAX_TOOL_CALLS=12
KIOSY_RUN_MAX_LLM_CALLS=6
KIOSY_RUN_ACTIVE_TIMEOUT_SECONDS=120
KIOSY_RUN_MAX_MESSAGE_CHARS=8000
KIOSY_RUN_MAX_ESTIMATED_TOKENS=12000
KIOSY_RUN_RATE_LIMIT_PER_HOUR=20
KIOSY_RUN_MAX_ACTIVE_PER_USER=2
KIOSY_RUN_MAX_ACTIVE_GLOBAL=20
KIOSY_WORKER_LEASE_SECONDS=60
KIOSY_WORKER_HEARTBEAT_SECONDS=20
KIOSY_MCP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
KIOSY_MCP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
