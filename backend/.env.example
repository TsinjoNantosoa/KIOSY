KIOSY_ENV=development
KIOSY_DATABASE_URL=postgresql+psycopg://kiosy:kiosy@localhost:5432/kiosy
KIOSY_FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KIOSY_PUBLIC_API_URL=http://localhost:8000
KIOSY_COOKIE_SECURE=false
KIOSY_COOKIE_SAMESITE=lax
KIOSY_COOKIE_DOMAIN=
KIOSY_SECRET_KEY=replace-with-at-least-32-random-characters
KIOSY_TEST_PAYMENT_ENABLED=true
KIOSY_STORAGE_ENDPOINT=http://localhost:9000
KIOSY_STORAGE_BUCKET=kiosy-private
KIOSY_STORAGE_ACCESS_KEY=minioadmin
KIOSY_STORAGE_SECRET_KEY=replace-me
KIOSY_STORAGE_PUBLIC_ORIGIN=http://localhost:9000
KIOSY_QDRANT_URL=http://localhost:6333
KIOSY_EMAIL_MODE=mailpit
KIOSY_SMTP_HOST=localhost
KIOSY_SMTP_PORT=1025
KIOSY_SMTP_USERNAME=
KIOSY_SMTP_PASSWORD=
KIOSY_SMTP_FROM=Kiosy <no-reply@kiosy.example>
KIOSY_SMTP_STARTTLS=false
KIOSY_LLM_PROVIDER=disabled
KIOSY_AZURE_OPENAI_API_KEY=
KIOSY_AZURE_OPENAI_ENDPOINT=https://resource-name.openai.azure.com/
KIOSY_AZURE_OPENAI_DEPLOYMENT=deployment-name
KIOSY_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding-deployment-name
KIOSY_ENABLE_LIVE_AZURE=false
KIOSY_MCP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
KIOSY_MCP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
