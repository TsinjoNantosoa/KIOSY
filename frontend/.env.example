# Toutes les variables VITE_* sont PUBLIQUES : elles sont incluses dans le bundle.
# N'y placez jamais de secret, token, clé de paiement ou clé de fournisseur LLM.

# demo : données fictives en mémoire, aucun appel réseau transactionnel.
# api  : appels au backend FastAPI configuré ci-dessous, sans repli silencieux sur les mocks.
VITE_APP_MODE=demo

# URL HTTPS de l'API (ex. https://api.kiosy.example). Ignorée en mode demo.
VITE_API_BASE_URL=http://localhost:8000

# Origines HTTPS autorisées pour les fichiers, séparées par des virgules.
VITE_ASSET_ALLOWED_ORIGINS=

# Latence simulée en mode démo (ms), pour rendre visibles les états de chargement.
VITE_DEMO_LATENCY_MS=350
